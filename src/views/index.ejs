<% include('partials/header') %>
    <section>
        <div>
            <h2></h2>
            <p></p>
            <a href="/"></a>
        </div>
    </section>

    <section>
        <h3></h3>
        <div class="grid">
            <% if (people && people.length> 0) { %>
                <% people.forEach(person=> { %>
                    <div class="card">
                        <% if (person.image_url) { %>
                            <div class="img">
                                <img src="<%= person.image_url %>" alt="<%= person.name %>">
                            </div>
                            <% } else { %>
                                <div class="img placeholder-img"></div>
                                <% } %>
                                    <div class="info">
                                        <h4>
                                            <%= person.name %>
                                        </h4>
                                        <p>alive? <%= person.alive %>
                                        </p>
                                        <a href="/person/<%= person.id %>">Skoða nánar</a>
                                    </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="card">
                                <div class="info">
                                    <h4>Fann ekki upplýsingar</h4>
                                    <p>Bættu við upplýsingum</p>
                                </div>
                            </div>
                            <% } %>
        </div>
    </section>

    <%- include('partials/footer') %>