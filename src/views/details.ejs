<%- include('partials/header') %>

    <section class="featured">
        <div>
            <h2><%= people.name %></h2>
            <p>Eru þau lifandi? <%= people.alive ? 'Já' : 'Nei' %></p>
            <p>Hvar bjuggu þau í fyrstu bölvuninni? <%= people.place_name %></p>
            <p>Hvað heitir karakterinn þeirra? <%= people.character_name %></p>
            <p>Heimili karakterins: <%= people.home_name %></p>

            <% if (people.image_url) { %>
                <div>
                    <img src="<%= people.image_url %>" alt="<%= people.name %>">
                </div>
            <% } else {%>
            <div class="placeholder-img"></div> 
            <% } %>

            <br>
            <a href="/" class="btn-primary">
                Til baka á forsíðu
            </a>
        </div>
    </section>

    <%- include('partials/footer') %>  