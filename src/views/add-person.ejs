<%- include('partials/header') %>

    <section class="featured">
        <div>
            <h2>Bæta við nýrri manneskju</h2>
            <form action="/person/ny" method="post">
                <div>
                    <label for="name">Nafn persónar</label>
                    <input type="text" id="name" name="name">
                </div>
                <div>
                    <label for="alive">Lifandi?</label>
                    <select id="alive" name="alive">
                        <option value="true">Já</option>
                        <option value="false">Nei</option>
                    </select>
                </div>
                <div>
                    <label for="placeID">Hvar býr persónan?</label>
                    <select id="placeID" name="placeID">
                        <option value="">Veldu staðsetningu</option>
                        <% places.forEach((place) => { %>
                            <option value="<%= place.id %>"><%= place.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label for="characterID">Hvað heitir sögupersónan þeirra?</label>
                    <select id="characterID" name="characterID">
                        <option value="">Veldu karakter</option>
                        <% characters.forEach((character) => { %>
                            <option value="<%= character.id %>"><%= character.name %></option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label for="image_url">Slóð á mynd</label>
                    <input type="text" id="image_url" name="image_url" placeholder="https://...">
                </div>
                <button type="submit" class="btn-primary">Vista persónu</button>
            </form>
        </div>
    </section>

    <a href="/" class="btn-primary">
                Til baka á forsíðu
            </a>

    <%- include('partials/footer') %>